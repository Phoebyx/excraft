  },
  "disable_mob_generation": true,
  "legacy_random_source": false,
  "noise": {
    "height": 384,
    "min_y": -64,
    "size_horizontal": 1,
    "size_vertical": 2
  },
  "noise_router": {
    "barrier": 1,
    "continents": "minecraft:overworld/continents",
    "depth": "minecraft:overworld_amplified/depth",
    "erosion": "minecraft:overworld/erosion",
    "final_density": {
      "type": "minecraft:add",
      "argument1": {
        "type": "minecraft:add",
        "argument1": {
          "type": "minecraft:y_clamped_gradient",
          "from_y": -64,
          "to_y": 320,
          "from_value": 1,
          "to_value": -1
        },
        "argument2": {
          "type": "minecraft:squeeze",
          "argument": {
            "type": "minecraft:noise",
            "noise": "minecraft:spaghetti_3d_1",
            "xz_scale": 0.5,
            "y_scale": 1
          }
        }
      },
      "argument2": {
        "type": "minecraft:constant",
        "argument": -0.3
      }
    },
    "fluid_level_floodedness": 1,
    "fluid_level_spread": 1,
    "initial_density_without_jaggedness": 0,
    "lava": 0,
    "ridges": "minecraft:overworld/ridges",
    "temperature": 0.25,
    "vegetation": 0.25,
    "vein_gap": 1,
    "vein_ridged": 0,
    "vein_toggle": 0
  },
  "ore_veins_enabled": false,
  "sea_level": -64,
  "spawn_target": [],
  "surface_rule": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:vertical_gradient",
          "false_at_and_above": {
            "above_bottom": 5
          },
          "random_name": "minecraft:bedrock_floor",
          "true_at_and_below": {
            "above_bottom": 0
          }
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:bedrock"
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:stone_depth",
          "offset": 10,
          "surface_type": "ceiling",
          "add_surface_depth": true,
          "secondary_depth_range": 10
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:sandstone"
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:stone_depth",
          "offset": 10,
          "surface_type": "floor",
          "add_surface_depth": true,
          "secondary_depth_range": 50
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:sand"
          }
        }
      }
    ]
  }
}